cabal-version: 3.0
name:          tamatsuzura-common
version:       0.1.0.0
synopsis:      Pure shared domain types and core logic for TamaTsuzura
license:       NONE
build-type:    Simple

common shared-options
  default-language: GHC2021
  ghc-options:
    -Wall
    -Werror
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wpartial-fields
    -Wredundant-constraints

library
  import:          shared-options
  hs-source-dirs:  src
  exposed-modules:
    TamaTsuzura.Common.Api
    TamaTsuzura.Common.Document
    TamaTsuzura.Common.Text
    TamaTsuzura.Common.Validation
  build-depends:
      aeson      >= 2.1  && < 2.3
    , base       >= 4.18 && < 5
    , containers >= 0.6  && < 0.8
    , text       >= 2.0  && < 2.2
    , time       >= 1.12 && < 1.15

test-suite tamatsuzura-common-test
  import:         shared-options
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  build-depends:
      aeson              >= 2.1  && < 2.3
    , base               >= 4.18 && < 5
    , hspec              >= 2.11 && < 2.12
    , QuickCheck         >= 2.14 && < 2.16
    , tamatsuzura-common
    , text               >= 2.0  && < 2.2
    , time               >= 1.12 && < 1.15
