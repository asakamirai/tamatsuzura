cabal-version: 3.0
name:          tamatsuzura-client
version:       0.1.0.0
synopsis:      GHC Wasm (Miso) mobile-first editor client for TamaTsuzura
license:       NONE
build-type:    Simple

common shared-options
  default-language: GHC2021
  ghc-options:
    -Wall
    -Werror
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wpartial-fields
    -Wredundant-constraints

-- クライアントコアは tamatsuzura-extensions に依存させないことで、
-- 拡張具体実装への誤参照をコンパイル時に防止する。
library client-core
  import:          shared-options
  hs-source-dirs:  src-core
  exposed-modules:
    TamaTsuzura.Client.App
  build-depends:
      base                      >= 4.18 && < 5
    , tamatsuzura-common
    , tamatsuzura-extension-api

-- 公開ライブラリはコアと結線層 (ExtensionRegistry) を束ねる。
library
  import:          shared-options
  hs-source-dirs:  src
  exposed-modules:
    TamaTsuzura.Client.ExtensionRegistry
  reexported-modules:
    TamaTsuzura.Client.App
  build-depends:
      base                      >= 4.18 && < 5
    , client-core
    , tamatsuzura-extension-api
    , tamatsuzura-extensions

executable tamatsuzura-client
  import:         shared-options
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:
      base               >= 4.18 && < 5
    , tamatsuzura-client
  if arch(wasm32)
    default-extensions: JavaScriptFFI
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"
    cpp-options: -DWASM

test-suite tamatsuzura-client-test
  import:         shared-options
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  build-depends:
      base                      >= 4.18 && < 5
    , hspec                     >= 2.11 && < 2.12
    , tamatsuzura-client
    , tamatsuzura-common
    , tamatsuzura-extension-api
