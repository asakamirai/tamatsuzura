cabal-version: 3.0
name:          tamatsuzura-server
version:       0.1.0.0
synopsis:      Stateless WAI (CGI and Warp) HTTP server for TamaTsuzura
license:       NONE
build-type:    Simple

common shared-options
  default-language: GHC2021
  ghc-options:
    -Wall
    -Werror
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wpartial-fields
    -Wredundant-constraints

library
  import:          shared-options
  hs-source-dirs:  src
  exposed-modules:
    TamaTsuzura.Server.App
  build-depends:
      aeson              >= 2.1 && < 2.3
    , base               >= 4.18 && < 5
    , http-types         >= 0.12 && < 0.13
    , tamatsuzura-common
    , text               >= 2.0 && < 2.2
    , wai                >= 3.2 && < 3.3

executable tamatsuzura-server
  import:         shared-options
  hs-source-dirs: app
  main-is:        WarpMain.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base               >= 4.18 && < 5
    , tamatsuzura-server
    , text               >= 2.0 && < 2.2
    , warp               >= 3.3 && < 3.5

executable tamatsuzura-cgi
  import:         shared-options
  hs-source-dirs: app
  main-is:        CgiMain.hs
  build-depends:
      base               >= 4.18 && < 5
    , tamatsuzura-server
    , wai-extra          >= 3.1 && < 3.2

test-suite tamatsuzura-server-test
  import:         shared-options
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  build-depends:
      base               >= 4.18 && < 5
    , hspec              >= 2.11 && < 2.12
    , http-types         >= 0.12 && < 0.13
    , tamatsuzura-server
    , wai                >= 3.2 && < 3.3
    , wai-extra          >= 3.1 && < 3.2
